# Copy this file to ".env" and fill in your own keys. NEVER commit the real .env.

# Required — powers CV parsing, job matching, cover letters and form answers.
# Free key from https://console.groq.com
GROQ_API_KEY=

# Optional — Adzuna job board (disabled by default in config/platforms.json).
# Free App ID + key from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Optional — Reed job board (disabled by default). https://www.reed.co.uk/developers
REED_API_KEY=

# Optional — CAPTCHA solving for application forms (hCaptcha / reCAPTCHA v2).
# Paid, pay-as-you-go from https://capsolver.com . Leave blank to skip solving.
CAPSOLVER_API_KEY=

# Optional — Telegram notifications (not required to run the app).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
